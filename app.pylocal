elif st.session_state.current_page == "Document Intelligence":
    st.markdown(f"""
    <div class="main-header">
        <span class="langchain-badge">🦜 LangChain Document Processing</span>
        <h1 style='margin:0; color: {PRIMARY_COLOR};'>Document Intelligence Center</h1>
        <p style='color: #64748B;'>Upload, process, and query your health documents with AI-powered analysis.</p>
    </div>
    """, unsafe_allow_html=True)
    
    # Supported Formats Display
    with st.expander("📋 Supported File Formats", expanded=False):
        for category, formats in SUPPORTED_FORMATS.items():
            st.markdown(f"**{category}**")
            format_chips = " ".join([f"`{ext}` {info['icon']}" for ext, info in formats.items()])
            st.markdown(format_chips)
        st.markdown("---")
        st.info("🔬 Images are processed using GPT-4 Vision for OCR and content extraction.")
    
    # File Upload Section
    st.markdown("### 📤 Upload Health Documents")
    
    uploaded_files = st.file_uploader(
        "Drag and drop files here",
        type=ALL_EXTENSIONS,
        accept_multiple_files=True,
        help="Upload lab reports, medical records, prescriptions, and other health documents."
    )
    
    if uploaded_files:
        st.markdown("### 📄 Processing Queue")
        
        process_btn = st.button("🚀 Process All Documents", type="primary", use_container_width=True)
        
        if process_btn:
            progress_bar = st.progress(0)
            status_text = st.empty()
            
            for idx, file in enumerate(uploaded_files):
                progress = (idx + 1) / len(uploaded_files)
                progress_bar.progress(progress)
                status_text.text(f"Processing: {file.name}")
                
                file_ext = file.name.split('.')[-1].lower()
                
                # Check if already processed
                file_hash = st.session_state.doc_processor.get_file_hash(file.getvalue())
                if file_hash in [f.get('hash') for f in st.session_state.uploaded_files]:
                    st.info(f"⏭️ Skipping {file.name} (already processed)")
                    continue
                
                # Process based on file type
                if file_ext in ['png', 'jpg', 'jpeg', 'webp', 'gif', 'bmp', 'tiff']:
                    # Image processing with Vision
                    docs = st.session_state.doc_processor.process_image_with_vision(
                        file.getvalue(), 
                        file.name
                    )
                else:
                    # Save to temp file and process
                    with tempfile.NamedTemporaryFile(delete=False, suffix=f'.{file_ext}') as tmp:
                        tmp.write(file.getvalue())
                        tmp_path = tmp.name
                    
                    docs = st.session_state.doc_processor.load_document(tmp_path, file_ext)
                    os.unlink(tmp_path)
                
                # Add to vector store
                st.session_state.doc_processor.add_to_vector_store(docs)
                st.session_state.uploaded_files.append({
                    'name': file.name,
                    'type': file_ext,
                    'hash': file_hash,
                    'chunks': len(docs)
                })
            
            progress_bar.progress(1.0)
            status_text.text("✅ All documents processed!")
            st.success(f"Successfully processed {len(uploaded_files)} document(s)")
            st.rerun()
    
    # Document Status
    if st.session_state.uploaded_files:
        st.markdown("### 📚 Document Library")
        
        for file_info in st.session_state.uploaded_files:
            ext = file_info['type']
            icon = "📄"
            for cat_formats in SUPPORTED_FORMATS.values():
                if ext in cat_formats:
                    icon = cat_formats[ext]['icon']
                    break
            
            st.markdown(f"""
            <div class="chunk-card">
                <strong>{icon} {file_info['name']}</strong>
                <br><small style="color: #64748B;">Type: {ext.upper()} | Chunks: {file_info['chunks']}</small>
            </div>
            """, unsafe_allow_html=True)
        
        # Document Q&A
        st.markdown("---")
        st.markdown("### 🔍 Ask Questions About Your Documents")
        
        query = st.text_input(
            "Enter your question",
            placeholder="What are my vitamin D levels? Are there any concerning biomarkers?"
        )
        
        if query:
            with st.spinner("Searching documents and generating response..."):
                answer, sources = call_document_qa(query, st.session_state.active_specialist)
            
            st.markdown("#### Response")
            st.markdown(answer)
            
            if sources:
                with st.expander("📎 Source Documents"):
                    for i, doc in enumerate(sources, 1):
                        st.markdown(f"**Source {i}:**")
                        st.text(doc.page_content[:500] + "...")
        
        # Summary & Extraction
        st.markdown("---")
        col1, col2 = st.columns(2)
        
        with col1:
            if st.button("📝 Generate Document Summary", use_container_width=True):
                with st.spinner("Generating comprehensive summary..."):
                    summary = st.session_state.doc_processor.summarize_documents()
                    st.session_state.document_summary = summary
        
        with col2:
            if st.button("🧬 Extract Biomarkers", use_container_width=True):
                with st.spinner("Extracting biomarker data..."):
                    biomarkers = st.session_state.doc_processor.extract_biomarkers()
                    st.session_state.extracted_biomarkers = biomarkers
        
        if st.session_state.document_summary:
            st.markdown("#### Document Summary")
            st.markdown(st.session_state.document_summary)
        
        if st.session_state.extracted_biomarkers:
            st.markdown("#### Extracted Biomarkers")
            st.json(st.session_state.extracted_biomarkers)


