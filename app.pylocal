    <div class="main-header">
        <h1 style='margin:0; color: {PRIMARY_COLOR};'>⚙️ Settings & Preferences</h1>
        <p style='color: #64748B;'>Configure your AI Hope Wellness experience.</p>
    </div>
    """, unsafe_allow_html=True)
    
    tab1, tab2, tab3 = st.tabs(["Profile", "Data Management", "API Configuration"])
    
    with tab1:
        st.markdown("### User Profile")
        
        col1, col2 = st.columns(2)
        with col1:
            st.text_input("Name", value="Premium User")
            st.number_input("Age", value=35, min_value=18, max_value=120)
            st.selectbox("Biological Sex", ["Male", "Female"])
        
        with col2:
            st.number_input("Height (inches)", value=70)
            st.number_input("Weight (lbs)", value=175)
            st.selectbox("Activity Level", ["Sedentary", "Lightly Active", "Moderately Active", "Very Active", "Athlete"])
        
        st.markdown("### Health Goals")
        st.multiselect(
            "Select your primary health goals",
            ["Longevity", "Body Composition", "Energy", "Cognitive Performance", "Sleep Quality", "Hormone Optimization", "Disease Prevention", "Athletic Performance"],
            default=["Longevity", "Energy"]
        )
    
    with tab2:
        st.markdown("### Document Management")
        
        if st.session_state.uploaded_files:
            st.markdown(f"**{len(st.session_state.uploaded_files)} document(s) in library**")
            
            if st.button("🗑️ Clear All Documents", type="secondary"):
                st.session_state.doc_processor = HealthDocumentProcessor()
                st.session_state.uploaded_files = []
                st.session_state.document_summary = None
                st.session_state.extracted_biomarkers = None
                st.success("All documents cleared.")
                st.rerun()
        else:
            st.info("No documents uploaded yet.")
        
        st.markdown("### Conversation History")
        
        total_messages = sum(len(msgs) for msgs in st.session_state.messages.values())
        st.markdown(f"**{total_messages} messages across {len(SPECIALISTS)} specialists**")
        
        if st.button("🗑️ Clear All Conversations", type="secondary"):
            st.session_state.messages = {k: [] for k in SPECIALISTS.keys()}
            st.success("All conversations cleared.")
            st.rerun()
    
    with tab3:
        st.markdown("### API Configuration")
        st.info("API keys are managed through environment variables for security.")
        
        st.markdown("""
        **Required Environment Variables:**
        - `OPENAI_API_KEY` - For AI specialist consultations
        
        **Optional:**
        - `LANGCHAIN_API_KEY` - For LangSmith tracing
        - `LANGCHAIN_PROJECT` - LangSmith project name
        """)
        
        if os.getenv("OPENAI_API_KEY"):
            st.success("✓ OpenAI API key configured")
        else:
            st.error("✗ OpenAI API key not found")


