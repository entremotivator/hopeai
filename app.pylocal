    with tabs[4]:
        st.subheader("Sleep Optimization Protocol")
        
        st.markdown("""
        #### Sleep Architecture Goals
        - Total sleep: 7-9 hours
        - Deep sleep: 1.5-2 hours (20-25%)
        - REM sleep: 1.5-2 hours (20-25%)
