# --- LANGCHAIN DOCUMENT PROCESSOR CLASS ---
class HealthDocumentProcessor:
    def __init__(self):
        self.embeddings = OpenAIEmbeddings()
        self.text_splitter = RecursiveCharacterTextSplitter(
            chunk_size=1500,
            chunk_overlap=200,
            length_function=len,
            separators=["\n\n", "\n", ". ", " ", ""]
        )
        self.vector_store = None
        self.documents = []
        self.chat_memory = ConversationBufferMemory(
            memory_key="chat_history",
            return_messages=True,
            output_key="answer"
        )
        
    def get_file_hash(self, file_content: bytes) -> str:
        """Generate unique hash for file to prevent duplicate processing."""
        return hashlib.md5(file_content).hexdigest()
    
    def load_document(self, file_path: str, file_type: str) -> List[Document]:
        """Load document using appropriate LangChain loader."""
        documents = []
        
        try:
            if file_type == "pdf":
                loader = PyPDFLoader(file_path)
                documents = loader.load()
            elif file_type in ["docx", "doc"]:
                loader = Docx2txtLoader(file_path)
                documents = loader.load()
            elif file_type == "txt":
                loader = TextLoader(file_path, encoding='utf-8')
                documents = loader.load()
            elif file_type == "csv":
                loader = CSVLoader(file_path)
                documents = loader.load()
            elif file_type in ["xlsx", "xls"]:
                loader = UnstructuredExcelLoader(file_path)
                documents = loader.load()
            elif file_type == "json":
                loader = JSONLoader(file_path, jq_schema='.', text_content=False)
                documents = loader.load()
            elif file_type in ["html", "htm"]:
                loader = UnstructuredHTMLLoader(file_path)
                documents = loader.load()
            elif file_type in ["md", "markdown"]:
                loader = UnstructuredMarkdownLoader(file_path)
                documents = loader.load()
            elif file_type in ["pptx", "ppt"]:
                loader = UnstructuredPowerPointLoader(file_path)
                documents = loader.load()
            elif file_type == "xml":
                loader = UnstructuredXMLLoader(file_path)
                documents = loader.load()
            elif file_type == "rtf":
                loader = UnstructuredRTFLoader(file_path)
                documents = loader.load()
            elif file_type == "epub":
                loader = UnstructuredEPubLoader(file_path)
                documents = loader.load()
            elif file_type == "odt":
                loader = UnstructuredODTLoader(file_path)
                documents = loader.load()
        except Exception as e:
            st.error(f"Error loading {file_type} file: {str(e)}")
            documents = [Document(page_content=f"Error loading file: {str(e)}", metadata={"source": file_path})]
            
        return documents
    
    def process_image_with_vision(self, image_bytes: bytes, filename: str) -> List[Document]:
        """Process image using GPT-4 Vision for OCR and analysis."""
        try:
            client = OpenAI()
            b64_image = base64.b64encode(image_bytes).decode('utf-8')
            
            response = client.chat.completions.create(
                model="gpt-4o",
                messages=[
                    {
                        "role": "system",
                        "content": """You are a medical document analyzer. Extract ALL text, numbers, and data from this image.
                        If it's a lab report, extract all biomarker names, values, units, and reference ranges.
                        If it's a medical document, extract all relevant clinical information.
                        Format the extracted data in a clear, structured manner."""
                    },
                    {
                        "role": "user",
                        "content": [
                            {"type": "text", "text": "Extract and analyze all content from this medical/health document:"},
                            {"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{b64_image}"}}
                        ]
                    }
                ],
                max_tokens=4096
            )
            
            extracted_text = response.choices[0].message.content
            return [Document(page_content=extracted_text, metadata={"source": filename, "type": "image_ocr"})]
            
        except Exception as e:
            return [Document(page_content=f"Error processing image: {str(e)}", metadata={"source": filename})]
    
    def chunk_documents(self, documents: List[Document]) -> List[Document]:
        """Split documents into optimized chunks for retrieval."""
        return self.text_splitter.split_documents(documents)
    
    def create_vector_store(self, documents: List[Document]) -> FAISS:
        """Create FAISS vector store from documents."""
        chunks = self.chunk_documents(documents)
        self.documents = chunks
        self.vector_store = FAISS.from_documents(chunks, self.embeddings)
        return self.vector_store
    
    def add_to_vector_store(self, documents: List[Document]):
        """Add new documents to existing vector store."""
        chunks = self.chunk_documents(documents)
        self.documents.extend(chunks)
        
        if self.vector_store is None:
            self.vector_store = FAISS.from_documents(chunks, self.embeddings)
        else:
            self.vector_store.add_documents(chunks)
    
    def get_retrieval_chain(self, specialist_prompt: str) -> ConversationalRetrievalChain:
        """Create conversational retrieval chain for document Q&A."""
        if self.vector_store is None:
            return None
            
        llm = ChatOpenAI(
            model_name="gpt-4o",
            temperature=0.3,
            streaming=True
        )
        
        condense_prompt = PromptTemplate.from_template(
            """Given the following conversation and a follow up question, rephrase the follow up question 
            to be a standalone question that incorporates relevant context from the chat history.
            
            Chat History:
            {chat_history}
            
            Follow Up Input: {question}
            Standalone question:"""
        )
        
        qa_prompt = ChatPromptTemplate.from_messages([
            SystemMessagePromptTemplate.from_template(specialist_prompt),
            HumanMessagePromptTemplate.from_template(
                """Use the following pieces of context from the patient's health documents to answer the question.
                If you don't know the answer based on the context, say so and provide general guidance.
                
                Context from documents:
                {context}
                
                Question: {question}
                
                Provide a thorough, clinically-informed response:"""
            )
        ])
        
        chain = ConversationalRetrievalChain.from_llm(
            llm=llm,
            retriever=self.vector_store.as_retriever(
                search_type="mmr",
                search_kwargs={"k": 6, "fetch_k": 12}
            ),
            memory=self.chat_memory,
            combine_docs_chain_kwargs={"prompt": qa_prompt},
            condense_question_prompt=condense_prompt,
            return_source_documents=True,
            verbose=False
        )
        
        return chain
    
    def semantic_search(self, query: str, k: int = 5) -> List[Document]:
        """Perform semantic search across all documents."""
        if self.vector_store is None:
            return []
        return self.vector_store.similarity_search(query, k=k)
    
    def summarize_documents(self) -> str:
        """Generate a comprehensive summary of all loaded documents."""
        if not self.documents:
            return "No documents loaded."
            
        llm = ChatOpenAI(model_name="gpt-4o", temperature=0.3)
        chain = load_summarize_chain(llm, chain_type="map_reduce")
        
        # Limit to prevent token overflow
        docs_to_summarize = self.documents[:20]
        summary = chain.run(docs_to_summarize)
        return summary
    
    def extract_biomarkers(self) -> Dict[str, Any]:
        """Extract and structure biomarker data from documents."""
        if self.vector_store is None:
            return {}
            
        llm = ChatOpenAI(model_name="gpt-4o", temperature=0)
        
        extraction_prompt = """Analyze the following health document content and extract ALL biomarkers, lab values, and health metrics.
        Return the data as a JSON object with the following structure:
        {
            "biomarkers": [
                {"name": "...", "value": "...", "unit": "...", "reference_range": "...", "status": "optimal/normal/elevated/low"}
            ],
            "date": "...",
            "document_type": "...",
            "key_findings": ["...", "..."]
        }
        
        Content to analyze:
        {context}
        
        Return ONLY valid JSON:"""
        
        relevant_docs = self.semantic_search("lab results biomarkers blood test values", k=10)
        context = "\n\n".join([doc.page_content for doc in relevant_docs])
        
        response = llm.invoke(extraction_prompt.format(context=context))
        
        try:
            return json.loads(response.content)
        except:
            return {"raw_response": response.content}


# --- SESSION STATE MANAGEMENT ---
def initialize_state():
    if "messages" not in st.session_state:
        st.session_state.messages = {k: [] for k in SPECIALISTS.keys()}
    if "patient_data" not in st.session_state:
        dates = [datetime.now() - timedelta(days=i*7) for i in range(24, 0, -1)]
        st.session_state.patient_data = pd.DataFrame({
            "Date": dates,
            "HbA1c": np.clip(np.random.normal(5.2, 0.2, 24), 4.5, 6.5),
            "Testosterone": np.clip(np.random.normal(650, 50, 24), 400, 900),
            "CRP": np.clip(np.random.normal(0.8, 0.3, 24), 0.1, 3.0),
            "Vitamin_D": np.clip(np.random.normal(45, 5, 24), 20, 80),
            "Body_Fat": np.clip(np.random.normal(18, 1, 24), 10, 30),
            "Fasting_Glucose": np.clip(np.random.normal(92, 5, 24), 70, 120),
            "HDL": np.clip(np.random.normal(55, 8, 24), 35, 85),
            "LDL": np.clip(np.random.normal(110, 15, 24), 70, 180),
            "Triglycerides": np.clip(np.random.normal(100, 20, 24), 50, 200),
            "TSH": np.clip(np.random.normal(2.0, 0.5, 24), 0.5, 5.0),
        })
    if "current_page" not in st.session_state:
        st.session_state.current_page = "Executive Dashboard"
    if "active_specialist" not in st.session_state:
        st.session_state.active_specialist = list(SPECIALISTS.keys())[0]
    if "doc_processor" not in st.session_state:
        st.session_state.doc_processor = HealthDocumentProcessor()
    if "uploaded_files" not in st.session_state:
        st.session_state.uploaded_files = []
    if "document_summary" not in st.session_state:
        st.session_state.document_summary = None
    if "extracted_biomarkers" not in st.session_state:
        st.session_state.extracted_biomarkers = None

initialize_state()


# --- AI ENGINE WITH LANGCHAIN ---
def call_ai_specialist(specialist_name: str, user_input: str, history: List[Dict], image: Optional[Any] = None) -> str:
    """Enhanced AI call with LangChain document retrieval."""
    try:
        client = OpenAI()
        spec = SPECIALISTS[specialist_name]
        processor = st.session_state.doc_processor
        
        # Build context from documents if available
        doc_context = ""
        if processor.vector_store is not None:
            relevant_docs = processor.semantic_search(user_input, k=5)
            if relevant_docs:
                doc_context = "\n\n--- RELEVANT PATIENT DOCUMENTS ---\n"
                for i, doc in enumerate(relevant_docs, 1):
                    doc_context += f"\n[Document {i}]:\n{doc.page_content[:1000]}...\n"
                doc_context += "\n--- END DOCUMENTS ---\n"
        
        system_prompt = f"""{spec['prompt']}

This is AI Hope Wellness, a premium health intelligence platform created by The ATM Agency.
{doc_context}

Maintain a premium, clinical, and supportive tone throughout your response.
Structure your response clearly with headers and bullet points where appropriate.
Always conclude with a medical disclaimer."""
        
        messages = [{"role": "system", "content": system_prompt}]
        
        # Add conversation history
        for m in history[-10:]:
            messages.append(m)
        
        # Handle image input
        if image:
            b64_img = base64.b64encode(image.getvalue()).decode('utf-8')
            messages.append({
                "role": "user",
                "content": [
                    {"type": "text", "text": f"Analyzing clinical document: {user_input}"},
                    {"type": "image_url", "image_url": {"url": f"data:image/jpeg;base64,{b64_img}"}}
                ]
            })
        else:
            messages.append({"role": "user", "content": user_input})

        response = client.chat.completions.create(
            model="gpt-4o",
            messages=messages,
            temperature=0.4,
            max_tokens=4096
        )
        return response.choices[0].message.content
        
    except Exception as e:
        return f"⚠️ System Error: {str(e)}\n\nPlease ensure your OpenAI API key is configured correctly."


def call_document_qa(question: str, specialist_name: str) -> tuple[str, List[Document]]:
    """Use LangChain retrieval chain for document-based Q&A."""
    processor = st.session_state.doc_processor
    spec = SPECIALISTS[specialist_name]
    
    chain = processor.get_retrieval_chain(spec['prompt'])
    if chain is None:
        return "No documents have been uploaded yet. Please upload health documents first.", []
    
    result = chain({"question": question})
    return result["answer"], result.get("source_documents", [])


